      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The requirements of an identity framework for metaverse is defined in this standard.&#xD;&#xA;An identity framework for use across different metaverse systems is provided. Furthermore, the&#xD;&#xA;relevance between real world and virtual world entities is recognized. Business logic, operational&#xD;&#xA;procedures, and authentication programs is covered in this standard. Also, terminologies, a basic&#xD;&#xA;architectural framework, and key indicators are defined.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Identity</rdf:li>
               <rdf:li>identity framework</rdf:li>
               <rdf:li>identity framework for metaverse</rdf:li>
               <rdf:li>IEEE 3812.1â„¢</rdf:li>
               <rdf:li>metaverse</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">IEEE Std 3812.1â„¢-2023, IEEE Standard for General Requirements for Identity Framework for Metaverse</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Digital Finance and Economy Standards Committee of the IEEE Consumer Technology Society</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
