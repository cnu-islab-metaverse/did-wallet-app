{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/master/src/vs/workbench/contrib/tasks/common/tasks.schema.json",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wallet",
      "type": "shell",
      "command": "npm run dev:desktop",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "wallet" }
    },
    {
      "label": "Wallet (demo)",
      "type": "shell",
      "command": "npm run dev:desktop:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "wallet" }
    },
    {
      "label": "Demo (scenario run)",
      "type": "shell",
      "command": "npm run demo",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Wallet (archive)",
      "type": "shell",
      "command": "npm run dev:desktop",
      "options": { "cwd": "${workspaceFolder}", "env": { "WALLET_VIEW": "legacy" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "wallet" }
    },
    {
      "label": "Issuer (Gov24)",
      "type": "shell",
      "command": "npm run dev:issuer",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "services" }
    },
    {
      "label": "Issuer (CNU)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/cnu-issuer-web", "env": { "PORT": "20252" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "services" }
    },
    {
      "label": "Verifier",
      "type": "shell",
      "command": "npm run dev:verifier",
      "options": { "cwd": "${workspaceFolder}", "env": { "PORT": "20260" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new", "group": "services" }
    },
    {
      "label": "Wallet + Services",
      "dependsOn": ["Wallet", "Issuer (Gov24)", "Issuer (CNU)", "Verifier"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
